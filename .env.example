# GeoServer connection
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver

# Defaults applied when a tool omits workspace / SRS
GEOSERVER_DEFAULT_WORKSPACE=
GEOSERVER_DEFAULT_SRS=EPSG:4326

# Resilience knobs
GEOSERVER_TIMEOUT=30
GEOSERVER_RETRIES=2
GEOSERVER_RETRY_BACKOFF=0.5
GEOSERVER_VERIFY_TLS=true

# Map / web UI
GEO_MAP_OUTPUT_DIR=./maps
WEBUI_PORT=8000
# Optional web UI access control: Basic auth when BOTH are set (leave empty for
# a local single-user stack), and per-IP requests/minute on the LLM routes.
WEBUI_USER=
WEBUI_PASSWORD=
WEBUI_RATE_LIMIT=30
# Seconds the chat caches the WMS layer catalog (0 = refetch every request).
GEO_CATALOG_TTL=60
# Constrain the chat resolver's reply with a JSON Schema (layer names as an enum).
GEO_RESOLVER_STRUCTURED=true

# OpenTelemetry (opt-in): traces + gen_ai metrics over OTLP/HTTP, e.g. a local
# Jaeger: docker run -p 16686:16686 -p 4318:4318 jaegertracing/jaeger:2.5.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Intelligent MCP agent (Microsoft Agent Framework)
# LLM provider: ollama (local) | ollama-cloud | anthropic | openai
# NOTE: the two `ollama` values speak Ollama's own /api/chat protocol. For an
# OpenAI-compatible endpoint (inference gateway, llama-swap, vLLM) use `openai`
# — pointing OLLAMA_HOST at such an endpoint fails on the URL, not the model.
GEO_LLM_PROVIDER=ollama

# -- provider: ollama (local) --
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3.6

# -- provider: ollama-cloud (https://ollama.com) --
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_API_KEY=
# For the cloud, set OLLAMA_MODEL to a cloud model, e.g. gpt-oss:120b

# -- provider: anthropic (Claude) --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# -- provider: openai (any OpenAI-compatible /v1 endpoint) --
# Leave OPENAI_BASE_URL empty for OpenAI itself. For a self-hosted gateway give
# the full /v1 URL; from a container use host.docker.internal, never 127.0.0.1
# (which is the container itself).
#OPENAI_BASE_URL=http://host.docker.internal:8091/v1
# Required. Behind a gateway this is a key in its model list, not a file name.
OPENAI_LLM_MODEL=
# Optional for a keyless gateway (a placeholder is sent, since the OpenAI SDK
# will not construct a client without one). Required for OpenAI itself.
OPENAI_API_KEY=

# MCP transport: stdio (for MCP clients that spawn the process) or http
GEO_MCP_TRANSPORT=stdio
# 127.0.0.1 keeps a local HTTP server off the LAN; docker-compose sets 0.0.0.0.
GEO_MCP_HOST=127.0.0.1
GEO_MCP_PORT=9000

# Safety: destructive tools (geo_delete_*, geo_wfs_transaction) are blocked
# unless this is true. The agent reports a refusal instead of deleting.
GEO_ALLOW_DESTRUCTIVE=false

# Integration tests (set to 1 to run tests/integration against a real GeoServer)
GEO_RUN_INTEGRATION=0

# Data bootstrap (compose service `geo-init`): loads EVERY shapefile under
# ./data into PostGIS and publishes each as a GeoServer layer. Idempotent.
GEO_INIT_ENABLE=true
GEO_INIT_WORKSPACE=ispra
GEO_INIT_DATASTORE=ispra_pg
# All layers are reprojected to this SRS on load.
GEO_INIT_TARGET_SRS=EPSG:4326
# Fallback source SRS for shapefiles shipped without a .prj (leave empty if all
# your shapefiles have one).
GEO_INIT_SOURCE_SRS=
# Set true to drop & reload tables that are already populated.
GEO_INIT_FORCE=false
# Apply the thematic SLD styles (hazard class / movement type) after publishing.
GEO_INIT_STYLES=true
# Let the LLM write title/abstract/keywords for newly published vector layers
# (never replaces hand-written metadata). Needs a reachable LLM.
GEO_INIT_AI_METADATA=false
GEO_UPLOAD_AI_METADATA=false
GEO_AI_METADATA_LANGUAGE=Italian
# Rasters (GeoTIFF) are registered as external coverages, so the GeoServer
# container must see the same /data path. Disable them, or filter with
# comma-separated globs relative to the data dir, e.g. dtm/*,clc2018_it/*.
GEO_INIT_RASTER_ENABLE=true
GEO_INIT_RASTER_INCLUDE=
GEO_INIT_RASTER_EXCLUDE=
# Shapefile attribute encoding (ISPRA data ships ISO-8859-1 in a .cst that GDAL
# ignores). Leave empty to let GDAL auto-detect.
GEO_INIT_SHAPE_ENCODING=ISO-8859-1

# --- Host port mapping (published ports) ---
# The container ports are fixed; these set the HOST-side ports so the whole
# stack can run alongside another one (e.g. a second GeoServer/Postgres/app).
# Defaults match the standard ports; change them to avoid clashes, e.g.:
#   GEOSERVER_HOST_PORT=18080
#   WEBUI_HOST_PORT=18000
#   POSTGIS_HOST_PORT=15432
#   MCP_HOST_PORT=19000
GEOSERVER_HOST_PORT=8080
WEBUI_HOST_PORT=8000
POSTGIS_HOST_PORT=5432
MCP_HOST_PORT=9000
