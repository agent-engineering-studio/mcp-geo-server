# GeoServer connection
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver

# Defaults applied when a tool omits workspace / SRS
GEOSERVER_DEFAULT_WORKSPACE=
GEOSERVER_DEFAULT_SRS=EPSG:4326

# Resilience knobs
GEOSERVER_TIMEOUT=30
GEOSERVER_RETRIES=2
GEOSERVER_RETRY_BACKOFF=0.5
GEOSERVER_VERIFY_TLS=true

# Map / web UI
GEO_MAP_OUTPUT_DIR=./maps
WEBUI_PORT=8000

# Intelligent MCP agent (Microsoft Agent Framework)
# LLM provider: ollama (local) | ollama-cloud | anthropic
GEO_LLM_PROVIDER=ollama

# -- provider: ollama (local) --
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# -- provider: ollama-cloud (https://ollama.com) --
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_API_KEY=
# For the cloud, set OLLAMA_MODEL to a cloud model, e.g. gpt-oss:120b

# -- provider: anthropic (Claude) --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# MCP transport: stdio (for MCP clients that spawn the process) or http
GEO_MCP_TRANSPORT=stdio
GEO_MCP_HOST=0.0.0.0
GEO_MCP_PORT=9000

# Integration tests (set to 1 to run tests/integration against a real GeoServer)
GEO_RUN_INTEGRATION=0
